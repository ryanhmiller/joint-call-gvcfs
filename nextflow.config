// merge-gvcfs: joint-call ~1500 gVCFs from nf-core/sarek into one cohort VCF.

params {
    // Inputs
    input        = null   // CSV: sample_id,gvcf,gvcf_tbi (absolute paths)
    fasta        = null   // ref.fa
    fai          = null   // ref.fa.fai
    dict         = null   // ref.dict

    // Interval splitting
    interval_bp  = 10_000_000
    include_alt  = false  // chrUn_*, *_alt, *_decoy, HLA-*
    include_mito = true   // chrM

    // Output
    outdir       = 'results'
    cohort_name  = 'cohort'

    gdb_batch_size    = 50
    gdb_reader_threads = 4
}

// Singularity / Apptainer
singularity {
      enabled    = true
      autoMounts = true
      cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${launchDir}/singularity_cache"
      runOptions = '-B /home/ryanhm/groups,/grphome,/nobackup'
}
apptainer.enabled = false  // set true and singularity.enabled=false if your site requires apptainer

// Sensible defaults
process {
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 247) ? 'retry' : 'finish' }
    maxRetries    = 2
    scratch       = true   // stage to node-local /tmp; copy outputs back to work/
}

executor {
    $slurm {
        queueSize       = 64    // bumped from 40 after --consolidate removal eased per-task GDB I/O
        submitRateLimit = '20/1min'
    }
    $local {
        cpus = 2
    }
}

profiles {
    standard { includeConfig 'conf/resources.config' }
    slurm    { includeConfig 'conf/slurm.config'
               includeConfig 'conf/resources.config' }
}

// Reports
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.svg";       overwrite = true }

manifest {
    name        = 'merge-gvcfs'
    description = 'Joint-call cohort gVCFs (GenomicsDBImport -> GenotypeGVCFs -> bcftools concat)'
    version     = '0.1.0'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.10.0'
}
