// Per-process resources. Tuned for ~1500-sample human WGS joint calling with
// ~10 Mb intervals. Retries escalate memory and wall time.
//
// Sizing logic (see README.md):
//   GenomicsDBImport on the previous 25 Mb interval took ~1.5h/batch x 31 batches.
//   Cutting intervals to 10 Mb keeps per-task wall time well under 24h.

process {
    withLabel: process_genomicsdb {
        cpus   = 4
        memory = { [32.GB, 48.GB, 64.GB][task.attempt - 1] }
        time   = { [24.h,  36.h,  48.h ][task.attempt - 1] }
    }

    withLabel: process_genotype {
        cpus   = 2
        memory = { [16.GB, 32.GB, 48.GB][task.attempt - 1] }
        time   = { [ 8.h,  16.h,  24.h ][task.attempt - 1] }
    }

    withLabel: process_concat {
        cpus   = 4
        memory = { [16.GB, 32.GB, 48.GB][task.attempt - 1] }
        time   = { [ 6.h,  12.h,  24.h ][task.attempt - 1] }
    }
}
