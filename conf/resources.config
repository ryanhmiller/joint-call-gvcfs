// Per-process resources. Tuned for ~1500-sample human WGS joint calling with
// ~10 Mb intervals. Retries escalate memory and wall time.
//
// Sizing logic (see README.md):
//   GenomicsDBImport on the previous 25 Mb interval took ~1.5h/batch x 31 batches.
//   Cutting intervals to 10 Mb keeps per-task wall time well under 24h.

process {
    withName: 'GATK4_GENOMICSDBIMPORT' {
        scratch = false   // workspace too large for node-local /tmp; run in NXF work dir on shared FS
        maxForks = 30     // 2026-06-24: post-consolidate. With --consolidate each GDB = ~90 files (was ~2,282), so all 1,559 dbs coexist at ~140K files = 7% of the 2M inode cap -> the inode throttle (old maxForks=12) + gdb_janitor are obsolete and removed. maxForks is now purely an FS-load ceiling while the archive migration is active. 12 would have been dangerous: consolidate inflates per-task time (~50min -> est. 65-105min), stretching the GDB phase to ~6-9 days at 12 forks, blowing the 7d wall before genotype starts. 30 keeps GDB at ~3 days. Watch plain `df` (bytes, not `df -i`) + abort rate on the first wave; lower if FS-stress aborts climb. See runbook 2026-06-24.
    }

    withName: 'GATK4_GENOTYPEGVCFS' {
        scratch = false   // ~1500-sample VCF + Java tmp blows out node-local /tmp; write to shared FS
    }

    withName: 'BCFTOOLS_CONCAT' {
        scratch = false   // ~100+ GB cohort VCF too large for node-local /tmp
    }

    // Option B (--reblock): one job per sample, embarrassingly parallel.
    // Single-sample gVCFs are small, so default scratch=true (node-local /tmp) is fine.
    // Wall-time ladders err generous (prefer a wasted-but-rare retry over a
    // walltime kill). 7-day Slurm cap = 168h; attempt-3 backstops below it so no
    // task can fail terminally on time. Sized for the Option B regime (reblocked
    // gVCFs + ~2 Mbp intervals); revisit once the first real wave reports actuals.
    withLabel: process_reblock {
        cpus   = 2
        memory = { [8.GB, 12.GB, 16.GB][task.attempt - 1] }
        time   = { [8.h,  16.h,  24.h ][task.attempt - 1] }   // whole-sample; ~9 GB gVCFs seen
    }

    withLabel: process_genomicsdb {
        cpus   = 8
        memory = { [48.GB, 72.GB,  96.GB ][task.attempt - 1] }
        time   = { [12.h,  24.h,   48.h  ][task.attempt - 1] }   // 2026-06-24: bumped from 6/12/24 to absorb --consolidate (extra read-all-fragments + rewrite-one pass, ~2.8 GB I/O over many small files on the slow FS). Import alone was ~50 min avg / 108 min max (06-19); remeasure consolidated on the chr22 test and retune.
    }

    withLabel: process_genotype {
        cpus   = 2
        memory = { [24.GB, 48.GB,  72.GB ][task.attempt - 1] }
        time   = { [48.h,  96.h,   168.h ][task.attempt - 1] }   // 2026-06-24: mem cut 72/100/120->24/48/72 and cpus 4->2. Observed peak RSS ~3.6 GB & ~0.26 cpu/task, so old request was hugely oversized and hurt Slurm backfill/fairshare. 24 GB A1 is still ~7x observed peak (headroom for dense regions). Smaller footprint packs more genotype into queueSize=128 -> widens the long pole with zero added FS load. Time ladder unchanged: realtimes top out ~19-23h (06-21), generous vs 48h A1; A3 backstops the 7d cap.
    }

    withLabel: process_concat {
        cpus   = 4
        memory = { [32.GB, 48.GB,  64.GB ][task.attempt - 1] }
        time   = { [24.h,  48.h,   72.h  ][task.attempt - 1] }   // now ~1600 small VCFs to stitch
    }
}
