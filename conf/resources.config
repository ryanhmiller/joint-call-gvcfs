// Per-process resources. Tuned for ~1500-sample human WGS joint calling with
// ~10 Mb intervals. Retries escalate memory and wall time.
//
// Sizing logic (see README.md):
//   GenomicsDBImport on the previous 25 Mb interval took ~1.5h/batch x 31 batches.
//   Cutting intervals to 10 Mb keeps per-task wall time well under 24h.

process {
    withName: 'GATK4_GDB_GENOTYPE' {
        scratch  = false   // GDB workspace + ~1500-sample VCF too large for node-local /tmp; run in NXF work dir on shared FS
        maxForks = 256     // 2026-06-25: Option B fused import+genotype. Inodes no longer bind (GDB is transient, rm'd in-task; at 256 forks peak ~584K files vs 1.9M free), so this is a fairshare/FS-load ceiling. Empirics: the 06-21 run sustained 128 concurrent at the heavier 4cpu/72GB; the right-sized 2cpu/16GB task here uses HALF the RAM at 256 (512 cores + 4 TB vs the 9 TB already sustained) and backfills better. Fusing also self-throttles imports to ~maxForks/15 (~17) concurrent FS-heavy import phases, so FS load stays gentle. Expect to float ~128-256 with low pgr2 fairshare; -resume covers any shortfall. Watch plain `df` (bytes) + abort rate on wave 1. See runbook 2026-06-25.
    }

    withName: 'BCFTOOLS_CONCAT' {
        scratch = false   // ~100+ GB cohort VCF too large for node-local /tmp
    }

    // Option B (--reblock): one job per sample, embarrassingly parallel.
    // Single-sample gVCFs are small, so default scratch=true (node-local /tmp) is fine.
    // Wall-time ladders err generous (prefer a wasted-but-rare retry over a
    // walltime kill). 7-day Slurm cap = 168h; attempt-3 backstops below it so no
    // task can fail terminally on time. Sized for the Option B regime (reblocked
    // gVCFs + ~2 Mbp intervals); revisit once the first real wave reports actuals.
    withLabel: process_reblock {
        cpus   = 2
        memory = { [8.GB, 12.GB, 16.GB][task.attempt - 1] }
        time   = { [8.h,  16.h,  24.h ][task.attempt - 1] }   // whole-sample; ~9 GB gVCFs seen
    }

    // Fused import+genotype (Option B). One task = GenomicsDBImport -> GenotypeGVCFs
    // -> rm -rf gdb. Sized to measured peaks from the 06-21 run (225 genotypes /
    // 174 imports at 2 Mbp, 1565 samples):
    //   peak RSS:  import median 1.0 GB / max 1.1 GB ; genotype median 3.4 / max 4.5 GB
    //   realtime:  import ~0.9 h ; genotype median 14.7 h / max 26.0 h
    // Fused peak mem = max(import, genotype) ~= 4.5 GB, so 16 GB A1 = ~3.5x headroom
    // (Xmx ~11g), a 3x cut from the old 48 GB import slot -> far lighter RAM TRES.
    // cpus=2: genotype is single-threaded (the ~15 h pole), import is I/O-bound; the
    // 4 reader-threads oversubscribe 2 cores harmlessly. time A1=48 h = 1.8x the 27 h
    // worst-case fused task; A3=168 h backstops the 7-day cap.
    withLabel: process_jointcall {
        cpus   = 2
        memory = { [16.GB, 32.GB,  64.GB ][task.attempt - 1] }
        time   = { [48.h,  96.h,   168.h ][task.attempt - 1] }
    }

    withLabel: process_concat {
        cpus   = 4
        memory = { [32.GB, 48.GB,  64.GB ][task.attempt - 1] }
        time   = { [24.h,  48.h,   72.h  ][task.attempt - 1] }   // now ~1600 small VCFs to stitch
    }
}
