// Slurm executor config. Edit partition/account/QoS for your site.

process {
    executor = 'slurm'

    // Uncomment and edit for your site:
    // queue          = 'general'                  // partition
    // clusterOptions = '--account=your_account'   // account / QoS

    // Common retry signals from Slurm (OOM, timeout, node failures).
    // null exitStatus = Nextflow could not read .exitcode in time (slow shared FS /
    // node hiccup, "terminated by external system") -> retry instead of killing the
    // whole run. See runbook 2026-06-17: GDB(1177) was misclassified this way and
    // aborted the run with default 'finish' on a ~5s exitcode-read overrun.
    // exit 1 = same FS-migration storm, but hitting the TASK's I/O (not the control
    // plane): GENOTYPEGVCFS(1382) died 2026-06-20 with a NUL-byte hole in its
    // .command.err mid-traversal (shared-FS write failure), exit 1, aborting the run.
    // Retry it too. exit 1 is also GATK's genuine USER ERROR code, so a real
    // deterministic error now burns maxRetries attempts before finishing -- accepted.
    errorStrategy = { (task.exitStatus == null || task.exitStatus in ((130..145) + 104 + 247 + 1)) ? 'retry' : 'finish' }
    maxRetries    = 2
    scratch       = true   // use $SLURM_TMPDIR / node-local /tmp
}

executor {
    // Tolerate slow .exitcode flushes on the stressed shared FS (archive migration).
    // Default is 270s; 1177 overran by ~5s and was killed. Give it generous room.
    exitReadTimeout = '20 min'
}
